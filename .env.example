# ---------------------------------------------------------------------------
# StockPilot environment
#
# Everything below is OPTIONAL. With no .env.local at all the app runs in
# "demo mode": the mock market-data provider serves seeded NSE data and the
# watchlist / portfolio persist to browser storage instead of Supabase.
# ---------------------------------------------------------------------------

# --- Supabase (auth + persistence) -----------------------------------------
# Project Settings -> API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key. Server-side only — never expose to the browser.
# Used by the daily recompute cron to write the recommendations cache.
SUPABASE_SERVICE_ROLE_KEY=

# Google sign-in. Set to 1 only *after* enabling the Google provider in the
# Supabase dashboard (Authentication -> Providers) and adding
# <your-project>.supabase.co/auth/v1/callback as an authorised redirect URI.
# Left unset, the sign-in screen omits the button entirely rather than showing
# one that errors.
NEXT_PUBLIC_OAUTH_GOOGLE=

# The same OAuth client ID pasted into the Supabase dashboard, repeated here for
# the browser. Supabase uses it to sign the user in; the browser needs it to
# mint Drive tokens so a Google account's data can be written to that account's
# own Drive instead of this project's database.
#
# Without it, Google sign-in still works but those users get no sync at all —
# their data stays in the browser. It deliberately does NOT fall back to
# Supabase; see src/lib/store/backend.ts.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# --- Market data provider ---------------------------------------------------
# "mock" (default) | "yahoo" | "angelone"
#
#   mock     Seeded simulation. No network, no keys. Every strategy has data.
#   yahoo    Real NSE/BSE prices AND fundamentals. No account needed, but the
#            endpoints are unofficial and delayed ~15 min — see the README
#            before using it for anything beyond personal research.
#   angelone Angel One SmartAPI. Needs a trading account; carries no
#            fundamentals, so the 5 long-term strategies stand down.
MARKET_DATA_PROVIDER=mock

# --- Yahoo Finance ----------------------------------------------------------
# Only read when MARKET_DATA_PROVIDER=yahoo. No credentials required.
YAHOO_RPS=5
YAHOO_CONCURRENCY=4

# --- Angel One SmartAPI -----------------------------------------------------
# Only read when MARKET_DATA_PROVIDER=angelone. Leave blank otherwise.
# Get these from https://smartapi.angelbroking.com/ -> My Apps
ANGEL_ONE_API_KEY=
ANGEL_ONE_CLIENT_CODE=
ANGEL_ONE_PASSWORD=
ANGEL_ONE_TOTP_SECRET=

# Request pacing. Brokerage APIs throttle hard and revise their limits, so these
# defaults are conservative — check the current SmartAPI docs before raising.
ANGEL_ONE_QUOTE_RPS=1
ANGEL_ONE_HISTORICAL_RPS=2
# How many historical-candle requests may be in flight at once.
MARKET_DATA_CONCURRENCY=4

# --- Cron -------------------------------------------------------------------
# Random string. Vercel Cron sends it as `Authorization: Bearer <secret>`.
CRON_SECRET=
