{
  "name": "wealthsensei",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3002",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "smoke": "tsx scripts/smoke-strategies.ts",
    "check:budget": "tsx scripts/check-budget-period.ts",
    "check:sync": "tsx --tsconfig scripts/tsconfig.json scripts/check-budget-sync.ts",
    "check:import": "tsx --tsconfig scripts/tsconfig.json scripts/check-xlsx-import.ts",
    "check:scrub": "tsx --tsconfig scripts/tsconfig.json scripts/check-scrub.ts",
    "check:symbols": "tsx scripts/check-symbols.ts",
    "smoke:yahoo": "tsx --tsconfig scripts/tsconfig.json scripts/smoke-yahoo.ts",
    "debug:scenarios": "tsx scripts/debug-scenarios.ts",
    "check:geometry": "tsx --tsconfig scripts/tsconfig.json scripts/check-geometry.ts",
    "check:feed": "tsx --tsconfig scripts/tsconfig.json scripts/check-feed-geometry.ts",
    "check:confidence": "tsx --tsconfig scripts/tsconfig.json scripts/check-confidence-spread.ts",
    "check:resample": "tsx --tsconfig scripts/tsconfig.json scripts/check-resample.ts",
    "check:lookahead": "tsx --tsconfig scripts/tsconfig.json scripts/check-lookahead.ts",
    "backtest:fetch": "tsx --tsconfig scripts/tsconfig.json scripts/fetch-history.ts",
    "backtest": "tsx --tsconfig scripts/tsconfig.json scripts/backtest.ts",
    "check:resolution": "tsx --tsconfig scripts/tsconfig.json scripts/check-trade-resolution.ts",
    "check:all": "npm run typecheck && npm run lint && npm run test && npm run check:geometry && npm run check:feed && npm run check:confidence && npm run check:resolution && npm run check:lookahead && npm run check:sync && npm run check:import && npm run check:scrub",
    "test": "vitest run",
    "test:watch": "vitest",
    "icons": "tsx --tsconfig scripts/tsconfig.json scripts/generate-icons.ts"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@sentry/nextjs": "^10.70.0",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.0",
    "@tanstack/react-virtual": "^3.14.9",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "framer-motion": "^11.18.0",
    "lightweight-charts": "^4.2.3",
    "lucide-react": "^0.469.0",
    "next": "^15.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.24.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^6.0.5",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.1",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.5",
    "typescript": "^5.7.3",
    "vitest": "^4.1.10"
  }
}
