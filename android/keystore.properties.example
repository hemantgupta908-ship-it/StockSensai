# Release signing for the Play upload. Copy to `keystore.properties` and fill in.
#
# `keystore.properties` is gitignored and must stay that way: whoever holds this
# file and the key it points at can publish updates to the listing.
#
# To create the upload key (run once, from the `android/` directory):
#
#   keytool -genkeypair -v -keystore upload-keystore.jks \
#     -alias upload -keyalg RSA -keysize 2048 -validity 10000
#
# keytool prompts for a password and for your name/organisation. Choose the
# password yourself and store it in a password manager — it cannot be reset, and
# Google cannot recover it for you.
#
# With Play App Signing (the default for new apps) this is only the *upload*
# key: Google holds the real signing key, and if you ever lose this one you can
# ask them to register a replacement. Without it, losing this file ends your
# ability to ship updates under this listing.

# Path to the keystore, relative to the `android/` directory.
storeFile=upload-keystore.jks

# The password you gave keytool for the keystore.
storePassword=

# The -alias you passed to keytool.
keyAlias=upload

# The key's own password. keytool uses the store password when you press enter
# at its prompt, in which case put the same value here.
keyPassword=
